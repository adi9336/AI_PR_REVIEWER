# Production env for docker compose — copy to .env and fill in real values.
# NEVER commit this file.

# Postgres (managed by the compose stack)
POSTGRES_PASSWORD=change-me-strong-password

# App secrets — same meaning as backend/.env
OPENAI_API_KEY=sk-...
GITHUB_WEBHOOK_SECRET=change-me-match-the-github-webhook
GOVERNANCE_API_KEY=change-me
GITHUB_TOKEN=ghp_...          # repo read scope — lets the worker fetch diffs

# DB + queue (internal service names — do not change the hosts)
TIGER_DATABASE_URL=postgresql://app:change-me-strong-password@postgres:5432/tiger
REDIS_URL=redis://redis:6379/0

# Optional per-step model overrides
MODEL_REASONING=gpt-4o-mini
MODEL_CODEGEN=gpt-4o-mini
