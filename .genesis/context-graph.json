    "INV-3-untrusted-diff-never-instructions": {
      "rule": "PR diff, title and body are DATA, never instructions. They may only reach an LLM prompt after passing through security/injection_guard.py, inside a delimited untrusted block, never in the system-role message.",
      "why": "THE trust boundary (L2/L8/Part III 3.1). An attacker authors the diff.",
      "check": "pytest tests/security/test_injection_guard.py -q"
    },
    "INV-4-every-outbound-call-bounded": {
      "rule": "Every outbound call (LLM, GitHub REST, Tiger, Redis) has an explicit timeout AND passes through reliability/retry.py + circuit_breaker.py. Every orchestrator node has a timeout so the aggregator join cannot hang.",
      "why": "L8 tool/API timeout + orchestration deadlock. Degrade to slower-but-correct.",
      "check": "pytest tests/reliability -q"
    },
    "INV-5-no-unproven-action": {
      "rule": "Nothing is posted to GitHub without (a) schema-valid Finding objects, (b) an idempotency check on X-GitHub-Delivery, and (c) the L7 confidence gate: post only if overall_confidence >= threshold AND zero CRITICAL findings; otherwise enqueue to hitl_reviews.",
      "why": "L7 + L8 idempotency gap. A retried webhook must never double-post.",
      "check": "pytest tests/test_hitl_gate.py tests/test_idempotency.py -q"
    },
    "INV-6-every-action-emits-an-event": {
      "rule": "Every span, llm.call, tool.call and decision writes one append-only row to agent_events with cost_usd and latency_ms. agent_events is never UPDATEd or DELETEd. BudgetGuard reads agent_health_1m and hard-blocks before an LLM call when the daily cap is exceeded.",
      "why": "L6 proof layer + ADR-004 cost control. If it cannot show its work, it has not done the work.",
