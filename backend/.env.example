# ── ai-pr-review-agent environment ─────────────────────────────────────────
# Real values go in backend/.env (gitignored). Copy this to backend/.env and fill in.

# Tiger Cloud — the single data spine (ADR-0001). Format: postgres://USER:PASS@HOST:PORT/DB?sslmode=require
TIGER_DATABASE_URL=postgres://tsdbadmin:REPLACE_ME@stvusexuk7.kmw4voqqfl.tsdb.cloud.timescale.com:30736/tsdb?sslmode=require

# OpenAI — embeddings (text-embedding-3-large, 256-dim) + LLM calls
OPENAI_API_KEY=

# GitHub App — webhook verification + posting PR reviews
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# Model routing (ADR-0002): reasoning on kimi-k3, code generation on hy3, both via opencode-go
MODEL_REASONING=kimi-k3
MODEL_CODEGEN=hy3

# Loop config (set at scaffold time)
LOOP_BUDGET_TOKENS=50000
LOOP_MAX_ITERS=10
EXPLAIN_DIFF=off
